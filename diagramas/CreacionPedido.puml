@startuml 'Creacion de Pedido'
skinparam style strictuml

actor Usuario
participant "Restaurante" as Restaurante
participant "Pedido" as Pedido
participant "ItemPedido" as ItemPedido

Usuario -> Pedido ** : Se crea el pedido (Salon / Retiro / Envio)
activate Pedido
Pedido -> Pedido: Se setea el estado EN_CONSTRUCCION
deactivate Pedido

Usuario -> Restaurante: Se registra el pedido
activate Restaurante
Restaurante -> Restaurante: Se valida que no este registrado
Restaurante -> Pedido: Se obtiene el estado del pedido
activate Pedido
Pedido --> Restaurante: Se devuelve el estado EN_CONSTRUCCION
deactivate Pedido
Restaurante -> Restaurante: Se agrega el pedido a la lista de pedidos
Restaurante --> Usuario: Pedido registrado
deactivate Restaurante

Usuario -> ItemPedido ** : Se crea el item con el producto y la cantidad
activate ItemPedido
ItemPedido -> ItemPedido: Se setea el estado PENDIENTE
deactivate ItemPedido

Usuario -> Pedido: Se agrega el item al pedido
activate Pedido
Pedido -> Pedido: Se guarda el historial de items
Pedido -> Pedido: Se agrega el item a la lista de items
Pedido --> Usuario: Item agregado
deactivate Pedido

@enduml
