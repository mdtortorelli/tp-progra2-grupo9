@startuml "TP Restaurante 'Fogón del Barrio' "

class Restaurante{
    - menu: Menu
    - pedidosTotales: Pedido[]
    - estacion: Estacion
    - itemsEnCocina: Map<Pedido, ItemPedido[]>

    - estaRegistrado(p: Pedido): boolean
    + registrarPedido(p: Pedido): void
    + getEstacion(): Estacion
    + setEstacion(e: Estacion): void
    + confirmarPedido(p: Pedido): void
    + obtenerItemsEnCocina(p: Pedido): ItemPedido[]
    + facturarPedido(p: Pedido, m: MetodoPago): void
    + obtenerPedidosFinalizados(): Pedido[]
    + obtenerDescuentoSemana(diaActual?: DiaSemana): number
    
    + getters y setters ()
}

abstract class Pedido{
    - cliente:Cliente,
    - pedidosItems:ItemPedido[]
    - estado:EstadoPedidos
    - metodoDePago:MetodoPago
    - historialItems: ItemPedido[][]
    - total: number | null = null
    - descuentoAplicado: number = 0

    - guardarHistorial(): void 
    + agregarItem():void
    + quitarItem():void
    + deshacerUltimaModificacion(): void
    + obtenerEstadosItems():void
    + confirmar(): void

    + getters y setters ()    
}

class Salon extends Pedido implements AtencionPedido{
    - mesa:Mesa

    + eliminarItem(): void
    + obtenerEstadoPedido(): EstadoPedido
    + consultarEstadosDeItems(): void
    + confirmarPedido(): void

    + getters y setters () 
}

class Retiro extends Pedido implements AtencionPedido{
    - horarioRetiro:DateTime

    + eliminarItem(): void
    + obtenerEstadoPedido(): EstadoPedido
    + consultarEstadosDeItems(): void
    + confirmarPedido(): void

    + getters y setters () 
}

class Envio extends Pedido{
    - direccion:String
    - costo:number

    - validarDireccion(direccion: string): void 
    - validarCosto(costo: number): void 
    
    + getters y setters () 
}

enum EstadoProducto{
    PENDIENTE
    EN_PREPARACION
    LISTO
}
enum EstadoPedidos{
    EN_CONSTRUCCION
    CONFIRMADO
    ENVIADO
}


class Menu{
    - categoria: CategoriaMenu
    - itemsMenu: Item[]

    + agregarItem(item:Item): void
    + quitarItem(item:Item): void
    + getters y setters ()
}

interface Item{
    + obtenerPrecio():number;
    + obtenerProductos(): Array<Producto>
}

class Mesa{
    - numero: number

    + getters y setters ()
}

interface AtencionPedido{
    + eliminarItem(): void
    + obtenerEstadoPedido(): EstadoPedido
    + consultarEstadosDeItems(): void
    + confirmarPedido(): void
}

class Producto implements Item {
    - nombre: string
    - precio: number
    - descripcion: string
    - categoria: CategoriaProd
    - estado: EstadoProducto

    + obtenerPrecio():number;
    + obtenerProductos(): Array<Producto>

    + getters y setters ()
}

class Combo implements Item {
    - productosCombos:Producto[]
    - precioCombo:number
    - tipoDescuento:TipoDescuento

    - calcularPrecioCombo():number
    + agregarProductoCombo(producto:Producto):void
    + quitarProductoCombo(producto:Producto):void
    + obtenerPrecioSinDescuento():number
    
    + obtenerPrecio():number;
    + obtenerProductos(): Array<Producto>

    + getters y setters ()    
}

class TipoDescuento {
    - descuento: number
    + obtenerMasBeneficioso(descuento1: number, descuento2: number): number
    + aplicarDescuento(combo:Combo):number

    + getters y setters ()
}

class DescuentoFijo implements TipoDescuento {   
    + aplicarDescuento(combo:Combo):number   
}

class DescuentoPorcentual implements TipoDescuento {
    + convertirPorcentajeADecimal():number
    + aplicarDescuento(combo:Combo):number  
}


class categoriaMenu{
    - productos:Producto[]

    + obtenerProductos():Producto[]
    + agregarProductoMenu(producto:Producto):void
    + quitarProductoMenu(producto:Producto):void
}

enum CategoriaProd {
    CARNE,
    ENSALADA,
    BEBIDA,
    POSTRE
}

enum DiaSemana {
    LUNES,
    MARTES,
    MIERCOLES,
    JUEVES,
    VIERNES,
    SABADO,
    DOMINGO
}

abstract class MetodoPago{
    - diaDescuento: DiaSemana
    - porcentajeDescuentoSemana: number
    - descuentoPropio: number

    + obtenerDescuentoSemana():number
    + obtenerPorcentajeDescuento(descuentoSemanal: number):number
    + realizarPago(p:Pedido, subtotal: number, descuentoSemanal: number):void 
    + getters y setters ()
}

class Efectivo extends MetodoPago{
    - descuento:double

    + getDescuento():number
    + setDescuento(descuento: number): void
}

abstract class Tarjeta extends MetodoPago{}

class Debito extends Tarjeta{}

class Credito extends Tarjeta{
    - cuotas: number

    + obtenerDescuentoSemana(descuentoSemanal: number): number
    + getters y setters ()
}

class BilleteraVirtual extends MetodoPago{}


abstract class Estacion{
    - nombre: String
    - categoria: CategoriaProd
    - colaItems: Queue<ItemPedido>
    - enPreparacion: ItemPedido[]
    - siguiente: Estacion

    + setSiguiente(e: Estacion): void
    + getSiguiente(): Estacion
    + puedePreparar(i: ItemPedido): boolean
    + recibir(i: ItemPedido): void
    + comenzarSiguiente(): ItemPedido
    + marcarListo(i: ItemPedido): void
    - estaEnPreparacion(i: ItemPedido): boolean
    + obtenerPendientes(): ItemPedido[]
    + obtenerEnPreparacion(): ItemPedido[]
    + getters y setters ()
}

class Parrilla extends Estacion{}
class CocinaFria extends Estacion{}
class Barra extends Estacion{}
class CocinaDulce extends Estacion{}

class ItemPedido {
    - item: Item
    - cantidad: number
    - estado: EstadoProducto
    + iniciar(): void
    + finalizar(): void
    + puedeModificarse(): boolean

    + getters y setters ()
}



Estacion o--  ItemPedido
Pedido *-r-  ItemPedido
Menu *-- categoriaMenu
Producto *--categoriaProd
Pedido .r.> Item
Menu .l.> Item
Salon *-- Mesa
Combo *-r-Producto
Pedido *-- MetodoPago
Restaurante -r-> Estacion : estacion
Estacion --> "0..1" Estacion : siguiente
Restaurante *--- Pedido
ItemPedido *-r- Item


note right of Estacion{
    Habria que crear una cola por cada tipo de estado? (LISTO,EN_PREPARACION,PENDIENTE)
}

@enduml